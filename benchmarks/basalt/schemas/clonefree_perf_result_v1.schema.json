{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visloc-rs.local/schemas/basalt/clonefree-perf-result-v1.schema.json",
  "title": "Basalt no-MargData/no-trace performance result and run manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "document_kind",
    "result_schema",
    "protocol",
    "run",
    "input",
    "build",
    "execution",
    "output_policy",
    "artifacts",
    "validation",
    "equivalence_52_frame",
    "self_binding",
    "constraints"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema_id": {"const": "basalt.clonefree_perf_result.v1"},
    "document_kind": {"enum": ["result", "run_manifest"]},
    "engine_kind": {"enum": ["rust", "native-wsl"]},
    "result_schema": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      },
      "additionalProperties": true
    },
    "protocol": {
      "type": "object",
      "required": ["id", "path", "sha256", "upstream_commit", "execution_policy_audit"],
      "properties": {
        "id": {"const": "basalt-euroc-parity-v1"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "upstream_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "execution_policy_audit": {
          "type": "object",
          "required": [
            "staged_copy_required_by_parity_protocol",
            "direct_path_used_for_performance_mode",
            "deviation_is_explicit"
          ],
          "properties": {
            "staged_copy_required_by_parity_protocol": {"const": true},
            "direct_path_used_for_performance_mode": {"const": true},
            "deviation_is_explicit": {"const": true}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": ["run_id", "sequence", "max_frames", "mode"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "string", "minLength": 1},
        "max_frames": {"type": "integer", "minimum": 1},
        "mode": {"const": "no-marg-data,no-trace"},
        "engine_kind": {"enum": ["rust", "native-wsl"]}
      },
      "additionalProperties": true
    },
    "input": {
      "type": "object",
      "required": [
        "dataset_path",
        "dataset_manifest_path",
        "dataset_manifest_sha256",
        "sequence_manifest_sha256",
        "sequence_archive_sha256",
        "frame_count_glob",
        "expected_frame_count",
        "sensor_file_hashes",
        "calibration_path",
        "calibration_sha256",
        "config_path",
        "config_sha256",
        "ground_truth_firewall"
      ],
      "properties": {
        "dataset_path": {"type": "string", "minLength": 1},
        "dataset_manifest_path": {"type": "string", "minLength": 1},
        "dataset_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "sequence_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "sequence_archive_path": {"type": "string", "minLength": 1},
        "sequence_archive_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "sequence_archive_binding": {"enum": ["dataset_manifest_freeze", "bytes_verified"]},
        "frame_count_glob": {"type": "string", "minLength": 1},
        "expected_frame_count": {"type": "integer", "minimum": 0},
        "expected_sensor_file_count": {"type": "integer", "minimum": 0},
        "sensor_file_hashes": {
          "type": "array",
          "items": {"$ref": "#/$defs/file_binding"}
        },
        "calibration_path": {"type": "string", "minLength": 1},
        "calibration_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "config_path": {"type": "string", "minLength": 1},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "ground_truth_firewall": {
          "type": "object",
          "required": [
            "ground_truth_path_passed_to_engine",
            "ground_truth_environment_keys_passed",
            "ground_truth_bytes_read_by_engine",
            "dataset_root_contains_post_exit_gt_metadata",
            "blocked_environment_keys_removed"
          ],
          "properties": {
            "ground_truth_path_passed_to_engine": {"const": false},
            "ground_truth_environment_keys_passed": {"const": false},
            "ground_truth_bytes_read_by_engine": {"const": false},
            "dataset_root_contains_post_exit_gt_metadata": {"const": true},
            "blocked_environment_keys_removed": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "build": {
      "type": "object",
      "required": ["executable_path", "executable_sha256"],
      "properties": {
        "engine_kind": {"enum": ["rust", "native-wsl"]},
        "executable_path": {"type": "string", "minLength": 1},
        "executable_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "native_adapter": {"$ref": "#/$defs/file_binding"},
        "native_source": {"$ref": "#/$defs/native_source"}
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "required": [
        "argv",
        "cwd",
        "returncode",
        "wall_seconds",
        "peak_process_tree_rss_bytes",
        "resource_poll_seconds",
        "started_utc",
        "finished_utc"
      ],
      "properties": {
        "argv": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "cwd": {"type": "string", "minLength": 1},
        "returncode": {"type": "integer"},
        "wall_seconds": {"type": "number", "minimum": 0},
        "peak_process_tree_rss_bytes": {"type": "integer", "minimum": 0},
        "resource_poll_seconds": {"type": "number", "exclusiveMinimum": 0},
        "started_utc": {"type": "string", "minLength": 1},
        "finished_utc": {"type": "string", "minLength": 1},
        "measurement_scope": {"enum": ["windows-process-tree", "native-linux-process-tree"]},
        "native_argv": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "native_process_tree": {"$ref": "#/$defs/native_process_tree"}
      },
      "additionalProperties": true
    },
    "output_policy": {
      "type": "object",
      "required": ["no_marg_data", "no_trace", "flags", "direct_path_output_root"],
      "properties": {
        "no_marg_data": {"const": true},
        "no_trace": {"const": true},
        "flags": {"type": "array", "items": {"type": "string"}, "minItems": 2},
        "direct_path_output_root": {"type": "string", "minLength": 1},
        "native_marg_data_argument": {"enum": ["not-applicable", "omitted"]}
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "required": ["files", "expected_absent"],
      "properties": {
        "files": {
          "type": "array",
          "items": {"$ref": "#/$defs/file_binding"}
        },
        "expected_absent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "reason", "present"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "present": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "protocol_binding_verified",
        "input_binding_verified",
        "output_policy_verified",
        "artifact_hashes_verified"
      ],
      "properties": {
        "status": {"enum": ["success", "failure"]},
        "protocol_binding_verified": {"type": "boolean"},
        "input_binding_verified": {"type": "boolean"},
        "output_policy_verified": {"type": "boolean"},
        "artifact_hashes_verified": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "equivalence_52_frame": {
      "type": "object",
      "required": [
        "evidence_path",
        "evidence_sha256",
        "frames",
        "counts",
        "trajectory_tum",
        "trajectory_csv",
        "trajectory_exact",
        "timing_usable_for_performance_gate"
      ],
      "properties": {
        "evidence_path": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "frames": {"const": 52},
        "counts": {"type": "object"},
        "trajectory_tum": {"$ref": "#/$defs/equivalence_binding"},
        "trajectory_csv": {"$ref": "#/$defs/equivalence_binding"},
        "trajectory_exact": {"const": true},
        "timing_usable_for_performance_gate": {"const": false}
      },
      "additionalProperties": true
    },
    "self_binding": {
      "type": "object",
      "required": ["path", "mode", "note"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "mode": {"const": "external_sha256"},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "required": ["timing_started", "heavy_build_started", "commit", "push", "destructive_actions"],
      "properties": {
        "timing_started": {"type": "boolean"},
        "heavy_build_started": {"type": "boolean"},
        "commit": {"const": false},
        "push": {"const": false},
        "destructive_actions": {"const": false}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["engine_kind"],
        "properties": {"engine_kind": {"const": "native-wsl"}}
      },
      "then": {
        "properties": {
          "build": {"required": ["native_adapter", "native_source"]},
          "execution": {"required": ["measurement_scope", "native_argv", "native_process_tree"]},
          "output_policy": {
            "required": ["native_marg_data_argument"],
            "properties": {"native_marg_data_argument": {"const": "omitted"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "file_binding": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      },
      "additionalProperties": true
    },
    "equivalence_binding": {
      "type": "object",
      "required": ["expected_sha256", "full_output", "no_marg_no_trace"],
      "properties": {
        "expected_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "full_output": {"$ref": "#/$defs/file_binding"},
        "no_marg_no_trace": {"$ref": "#/$defs/file_binding"}
      },
      "additionalProperties": true
    },
    "native_source": {
      "type": "object",
      "required": [
        "checkout_path",
        "commit",
        "tree_sha1",
        "expected_commit",
        "expected_tree_sha1",
        "binary",
        "config",
        "calibration"
      ],
      "properties": {
        "checkout_path": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "tree_sha1": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "expected_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "expected_tree_sha1": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "checkout_dirty": {"type": "boolean"},
        "dirty_paths": {"type": "array", "items": {"type": "string"}},
        "binary": {"$ref": "#/$defs/file_binding"},
        "config": {"$ref": "#/$defs/file_binding"},
        "calibration": {"$ref": "#/$defs/file_binding"}
      },
      "additionalProperties": true
    },
    "native_process_tree": {
      "type": "object",
      "required": ["schema", "command", "returncode", "wall_seconds", "peak_process_tree_rss_bytes", "resource_poll_seconds", "platform"],
      "properties": {
        "schema": {"const": "basalt.native_wsl_monitor.v1"},
        "command": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "returncode": {"type": "integer"},
        "wall_seconds": {"type": "number", "minimum": 0},
        "peak_process_tree_rss_bytes": {"type": "integer", "minimum": 0},
        "resource_poll_seconds": {"type": "number", "exclusiveMinimum": 0},
        "platform": {"const": "wsl-linux"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
